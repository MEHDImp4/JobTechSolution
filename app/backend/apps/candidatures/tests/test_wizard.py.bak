"""
Tests for the 3-step application wizard.
"""

from unittest.mock import patch

from django.contrib.auth import get_user_model
from django.core.files.uploadedfile import SimpleUploadedFile
from django.test import Client, TestCase
from django.urls import reverse

from apps.candidatures.models import Candidature
from apps.offres.models import Offre

User = get_user_model()


class CandidatureWizardTest(TestCase):
    """Test the multi-step application wizard flow."""

    def setUp(self):
        self.client = Client()
        self.user = User.objects.create_user(
            email='wizard-candidat@example.com',
            nom='Wizard',
            prenom='Candidat',
            password='password123',
            role='candidat',
            is_active=True,
        )
        self.offre = Offre.objects.create(
            titre='Django Developer',
            description='Expert needed for wizard testing',
            type_contrat='CDI',
            statut='publiee',
            created_by=self.user,  # Not realistic but works for setup
        )
        self.wizard_url = reverse('candidat:postuler')
        self.client.login(
            username='wizard-candidat@example.com', password='password123'
        )

    @patch('apps.ia.tasks.analyze_cv.delay')
    def test_full_wizard_success(self, mock_analyze_cv):
        """Test successful completion of the 3-step wizard."""

        # --- Step 1: Offre Choice ---
        # Data for the first step
        step1_data = {
            'candidature_wizard_view-current_step': 'offre',
            'offre-offre': self.offre.id,
        }
        response = self.client.post(self.wizard_url, step1_data)

        # Verify it moves to step 2 ('profil')
        self.assertEqual(response.status_code, 200)
        self.assertContains(response, 'Votre profil')  # Label in step 2 template

        # --- Step 2: Profile Details ---
        step2_data = {
            'candidature_wizard_view-current_step': 'profil',
            'profil-telephone': '+212600000000',
            'profil-linkedin_url': 'https://linkedin.com/in/testuser',
            'profil-experience_annees': 5,
            'profil-niveau_etude': 'master',
        }
        response = self.client.post(self.wizard_url, step2_data)

        # Verify it moves to step 3 ('cv')
        self.assertEqual(response.status_code, 200)
        self.assertContains(response, 'CV')
        self.assertContains(response, 'Motivation')

        # --- Step 3: CV Upload & Consent ---
        cv_content = b"%PDF-1.4\nMock CV content for wizard test"
        cv_file = SimpleUploadedFile(
            "cv_wizard.pdf", cv_content, content_type="application/pdf"
        )

        step3_data = {
            'candidature_wizard_view-current_step': 'cv',
            'cv-cv_file': cv_file,
            'cv-lettre_motivation': 'I am very motivated to test this wizard.',
            'cv-consentement_rgpd': 'on',  # Checkbox 'on' for True
        }
        response = self.client.post(self.wizard_url, step3_data)

        # Verify redirect to dashboard on completion
        self.assertRedirects(response, reverse('candidat:dashboard'))

        # Verify candidature creation in DB
        self.assertEqual(Candidature.objects.count(), 1)
        candidature = Candidature.objects.first()
        self.assertEqual(candidature.offre, self.offre)
        self.assertEqual(candidature.candidat, self.user)
        self.assertEqual(
            candidature.lettre_motivation, 'I am very motivated to test this wizard.'
        )
        self.assertEqual(candidature.cv_file_original_name, 'cv_wizard.pdf')

        # Verify IA task was triggered
        mock_analyze_cv.assert_called_once_with(candidature.id)

    def test_wizard_access_control(self):
        """Test that only candidates can access the wizard."""
        self.client.logout()

        # Try as anonymous user
        response = self.client.get(self.wizard_url)
        # Should redirect to login (SessionWizardView + LoginRequiredMixin/CandidatMixin)
        self.assertEqual(response.status_code, 302)

        # Try as admin user
        User.objects.create_superuser(
            email='admin-wizard@example.com',
            password='password123',
            nom='Admin',
            prenom='Wizard',
        )
        self.client.login(username='admin-wizard@example.com', password='password123')
        response = self.client.get(self.wizard_url)
        # CandidatMixin should block access (403 or redirect depending on implementation)
        # Check CandidatMixin in apps/accounts/mixins.py
        self.assertEqual(response.status_code, 403)

    def test_wizard_duplicate_application_step1(self):
        """Test that step 1 blocks if candidate already applied to this offer."""
        # Create first application
        Candidature.objects.create(
            offre=self.offre, candidat=self.user, cv_file_original_name='cv1.pdf'
        )

        step1_data = {
            'candidature_wizard_view-current_step': 'offre',
            'offre-offre': self.offre.id,
        }
        response = self.client.post(self.wizard_url, step1_data)

        # Should re-render step 1 with error
        self.assertEqual(response.status_code, 200)
        self.assertContains(response, 'Vous avez déjà postulé à cette offre.')
